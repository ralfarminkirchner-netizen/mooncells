diff --git a/tests/variantHandoff.test.ts b/tests/variantHandoff.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/variantHandoff.test.ts
@@ -0,0 +1,164 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { acknowledgeHandoff, canonicalJson, contentDigest, handoffDisplayText, isHandoffOperation, isSafeReturnUrl, loadHandoff, verifyHandoffEnvelope } from '../src/lib/variantHandoff.ts'
+import type { VariantHandoffEnvelope, VariantHandoffPacket, VariantHandoffReceipt } from '../src/types/variantHandoff.ts'
+
+const operation = 'operation_test_01'
+async function sign<T extends { digest: string }>(value: T): Promise<T> {
+  const contents = Object.fromEntries(Object.entries(value).filter(([key]) => key !== 'digest'))
+  return { ...value, digest: await contentDigest(contents) }
+}
+async function fixture(): Promise<VariantHandoffEnvelope> {
+  const binding = { componentId: 'component-test', sourceId: 'source-test', roomId: 'room-dazwischen', role: 'Offener technischer Anschluss', revision: 'summary-review', contentHash: null, bindingStatus: 'pinned' }
+  const variantSnapshot = { id: 'variant-test', title: 'Revidierte Gesamtfassung', componentBindings: [binding], notes: 'Offene Prüfung' }
+  const packet: VariantHandoffPacket = await sign({
+    format: 'kintegrity.roundtrip.v1', operationId: operation,
+    createdAt: '2026-10-27T19:00:00Z', digest: '',
+    source: {
+      catalogRevision: 'catalog-review', variantId: 'variant-test',
+      variantDigest: await contentDigest(variantSnapshot), variantSnapshot,
+      roomId: 'room-dazwischen', bindings: [{ ...binding, componentTitle: 'Eigenständiger Raumbeitrag' }],
+      sourceSummaries: [{ id: 'source-test', title: 'Öffentliche Übersicht', summary: 'Nur die freigegebene Zusammenfassung.', revision: 'summary-review', contentHash: null, visibility: 'public' }],
+      dissent: [{ id: 'dissent-test', title: 'Annahme bleibt offen', summary: 'Empfang begründet keine fachliche Zustimmung.' }],
+    },
+    navigation: { hash: '#variant=revision&room=daz&search=offen' },
+    mandate: { executor: 'Codex', role: 'Technische Ausführung', text: 'Einen echten, verantworteten technischen Rundweg umsetzen.', scope: 'Öffentlicher Paketempfang und gebundener Rückweg' },
+    target: { name: 'DAS DAZWISCHEN', revision: 'build-test' },
+    returnUrl: '/variantenraum/index.html#variant=revision&room=daz&search=offen',
+  })
+  return { packet, receipt: null, withdrawn: false, adoption: null }
+}
+async function received(envelope: VariantHandoffEnvelope): Promise<VariantHandoffEnvelope> {
+  const { packet } = envelope
+  const receipt: VariantHandoffReceipt = await sign({
+    id: 'receipt-test', packetDigest: packet.digest, digest: '', createdAt: '2026-10-27T19:05:00Z',
+    actor: { name: 'Codex', role: 'Technische Ausführung', mandate: packet.mandate.text, scope: packet.mandate.scope, identityBasis: 'configured-local-technical-executor' },
+    transport: 'received', review: 'not-reviewed', humanAcceptance: 'open', finding: 'Paket geladen, Bindung geprüft.',
+    targetRevision: packet.target.revision, returnUrl: packet.returnUrl,
+  })
+  return { ...envelope, receipt }
+}
+
+test('canonical JSON sorts nested keys and preserves Unicode values', () => {
+  assert.equal(canonicalJson({ z: [{ b: true, a: 'Rückweg' }], a: null }), '{"a":null,"z":[{"a":"Rückweg","b":true}]}')
+  assert.throws(() => canonicalJson({ a: undefined }))
+  assert.throws(() => canonicalJson({ a: Infinity }))
+  assert.throws(() => canonicalJson({ 'ä': 'unsupported key' }))
+})
+test('operation and return paths reject arbitrary origins and path tricks', () => {
+  assert.equal(isHandoffOperation(operation), true)
+  assert.equal(isHandoffOperation('../private'), false)
+  assert.equal(isSafeReturnUrl('/variantenraum/index.html#variant=choice'), true)
+  for (const path of ['https://elsewhere.test/variantenraum/index.html#x', '//elsewhere.test/#x', '/variantenraum/index.html?external=x#x', '/variantenraum/index.html#', '/variantenraum/index.html#x\n', '/variantenraum/index.html#x\\evil']) assert.equal(isSafeReturnUrl(path), false)
+})
+test('a verified packet is read-only until explicit acknowledgment', async () => {
+  const envelope = await fixture()
+  const verified = await verifyHandoffEnvelope(envelope, operation)
+  assert.equal(verified.receipt, null)
+  assert.equal(verified.withdrawn, false)
+  assert.deepEqual(verified, envelope)
+})
+test('packet tampering and wrong operation are refused', async () => {
+  const envelope = await fixture()
+  envelope.packet.source.variantSnapshot.title = 'Veränderte Fassung'
+  await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+  await assert.rejects(verifyHandoffEnvelope(await fixture(), 'other_operation'))
+})
+test('a re-signed packet cannot conceal mismatched snapshot digest', async () => {
+  const envelope = await fixture()
+  envelope.packet.source.variantSnapshot.title = 'Andere Fassung'
+  envelope.packet = await sign(envelope.packet)
+  await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+})
+test('private source payload fields are refused even if packet digest is valid', async () => {
+  const envelope = await fixture()
+  Object.assign(envelope.packet.source.sourceSummaries[0], { fulltext: 'Nicht zur Übertragung vorgesehen' })
+  envelope.packet = await sign(envelope.packet)
+  await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+})
+test('source binding must resolve to an included public summary', async () => {
+  const envelope = await fixture()
+  envelope.packet.source.bindings[0].sourceId = 'missing-source'
+  envelope.packet = await sign(envelope.packet)
+  await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+})
+test('room, variant and contribution must belong to the bound snapshot', async () => {
+  for (const mutation of [
+    (packet: VariantHandoffPacket) => { packet.source.variantId = 'other-variant' },
+    (packet: VariantHandoffPacket) => { packet.source.roomId = 'other-room' },
+    (packet: VariantHandoffPacket) => { packet.source.bindings[0].role = 'Unbelegte Zuständigkeit' },
+  ]) {
+    const envelope = await fixture()
+    mutation(envelope.packet)
+    envelope.packet = await sign(envelope.packet)
+    await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+  }
+})
+test('receipt preserves fixed executor, mandate and open human acceptance', async () => {
+  const envelope = await received(await fixture())
+  assert.deepEqual(await verifyHandoffEnvelope(envelope, operation), envelope)
+  assert.equal(envelope.receipt?.review, 'not-reviewed')
+  assert.equal(envelope.receipt?.humanAcceptance, 'open')
+})
+test('receipt integrity, actor, mandate, target and return binding are all checked', async () => {
+  for (const mutation of [
+    (receipt: VariantHandoffReceipt) => { receipt.finding = 'Anderer Befund' },
+    (receipt: VariantHandoffReceipt) => { receipt.actor.mandate = 'Anderer Auftrag' },
+    (receipt: VariantHandoffReceipt) => { receipt.actor.scope = 'Anderer Bereich' },
+    (receipt: VariantHandoffReceipt) => { Object.assign(receipt.actor, { identityBasis: 'self-asserted' }) },
+    (receipt: VariantHandoffReceipt) => { receipt.targetRevision = 'other-build' },
+    (receipt: VariantHandoffReceipt) => { receipt.returnUrl = '/variantenraum/index.html#other' },
+    (receipt: VariantHandoffReceipt) => { Object.assign(receipt.actor, { name: 'Behauptete Person' }) },
+    (receipt: VariantHandoffReceipt) => { Object.assign(receipt, { humanAcceptance: 'accepted' }) },
+  ]) {
+    const envelope = await received(await fixture())
+    mutation(envelope.receipt!)
+    if (envelope.receipt!.finding !== 'Anderer Befund') envelope.receipt = await sign(envelope.receipt!)
+    await assert.rejects(verifyHandoffEnvelope(envelope, operation))
+  }
+})
+test('withdrawn packets retain a verified historical receipt', async () => {
+  const envelope = await received(await fixture())
+  envelope.withdrawn = true
+  const verified = await verifyHandoffEnvelope(envelope, operation)
+  assert.equal(verified.withdrawn, true)
+  assert.ok(verified.receipt)
+})
+test('human display keeps identifiers and private paths in technical details', () => {
+  const text = handoffDisplayText('Stand 95f7923 und 12345678-abcd-1234-abcd-123456789abc bei /Volumes/Drive/private.md')
+  assert.equal(text.includes('95f7923'), false)
+  assert.equal(text.includes('12345678-abcd'), false)
+  assert.equal(text.includes('/Volumes/'), false)
+})
+test('load uses the same-origin read endpoint and rehydrates stored receipt', async (context) => {
+  const envelope = await received(await fixture())
+  context.mock.method(globalThis, 'fetch', async (url: string, init: RequestInit) => {
+    assert.equal(url, `/api/rundweg/handoffs/${operation}`)
+    assert.equal(init.credentials, 'same-origin')
+    assert.equal(init.cache, 'no-store')
+    assert.equal(init.method, undefined)
+    return new Response(JSON.stringify(envelope), { status: 200 })
+  })
+  assert.equal((await loadHandoff(operation)).receipt?.finding, envelope.receipt?.finding)
+})
+test('explicit receipt sends only digest, finding and disposition with request header', async (context) => {
+  const envelope = await received(await fixture())
+  context.mock.method(globalThis, 'fetch', async (url: string, init: RequestInit) => {
+    assert.equal(url, `/api/rundweg/handoffs/${operation}/receipt`)
+    assert.equal(init.method, 'POST')
+    assert.deepEqual(init.headers, { 'Content-Type': 'application/json', 'X-Rundweg-Request': '1' })
+    assert.deepEqual(JSON.parse(init.body as string), { packetDigest: envelope.packet.digest, finding: envelope.receipt!.finding, disposition: 'received' })
+    return new Response(JSON.stringify(envelope), { status: 200 })
+  })
+  assert.deepEqual(await acknowledgeHandoff(envelope.packet, ` ${envelope.receipt!.finding} `), envelope)
+})
+test('empty and too short findings never issue a receipt request', async (context) => {
+  const mock = context.mock.method(globalThis, 'fetch', async () => { throw new Error('must not request') })
+  await assert.rejects(acknowledgeHandoff((await fixture()).packet, '   '))
+  await assert.rejects(acknowledgeHandoff((await fixture()).packet, 'Kurz'))
+  assert.equal(mock.mock.callCount(), 0)
+})
+test('conflicting receipt and failed requests do not report success or expose payload', async (context) => {
+  context.mock.method(globalThis, 'fetch', async () => new Response('private-technical-token', { status: 409 }))
+  await assert.rejects(acknowledgeHandoff((await fixture()).packet, 'Technischer Befund'), (error: Error) => !error.message.includes('private-technical-token'))
+})
