+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue }
+
+export interface HandoffBinding {
+  componentId: string
+  componentTitle: string
+  sourceId: string
+  roomId: string
+  role: string
+  revision: string | null
+  contentHash: string | null
+  bindingStatus: string
+  [key: string]: JsonValue
+}
+
+export interface HandoffSourceSummary {
+  id: string
+  title: string
+  summary: string
+  revision: string | null
+  contentHash: string | null
+  visibility: 'public'
+}
+
+export interface HandoffDissent {
+  id: string
+  title: string
+  summary: string
+  [key: string]: JsonValue
+}
+
+export interface VariantHandoffPacket {
+  format: 'kintegrity.roundtrip.v1'
+  operationId: string
+  createdAt: string
+  digest: string
+  source: {
+    catalogRevision: string
+    variantId: string
+    variantDigest: string
+    variantSnapshot: { title: string; [key: string]: JsonValue }
+    roomId: string
+    bindings: HandoffBinding[]
+    sourceSummaries: HandoffSourceSummary[]
+    dissent: HandoffDissent[]
+  }
+  navigation: { hash: string }
+  mandate: { text: string; executor: 'Codex'; role: 'Technische Ausführung'; scope: string }
+  target: { name: 'DAS DAZWISCHEN'; revision: string }
+  returnUrl: string
+}
+
+export interface VariantHandoffReceipt {
+  id: string
+  packetDigest: string
+  digest: string
+  createdAt: string
+  actor: { name: 'Codex'; role: 'Technische Ausführung'; mandate: string; scope: string; identityBasis: 'configured-local-technical-executor' }
+  transport: 'received'
+  review: 'not-reviewed'
+  humanAcceptance: 'open'
+  finding: string
+  targetRevision: string
+  returnUrl: string
+}
+
+export interface VariantHandoffEnvelope {
+  packet: VariantHandoffPacket
+  receipt: VariantHandoffReceipt | null
+  withdrawn: boolean
+  adoption: JsonValue
+}
diff --git a/src/lib/variantHandoff.ts b/src/lib/variantHandoff.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/variantHandoff.ts
@@ -0,0 +1,170 @@
+import type { JsonValue, VariantHandoffEnvelope, VariantHandoffPacket, VariantHandoffReceipt } from '../types/variantHandoff.ts'
+
+const invalidMessage = 'Die Übergabe konnte nicht sicher geprüft werden. Eine Quittierung ist nicht möglich.'
+const hashPattern = /^[a-f0-9]{64}$/
+const operationPattern = /^[A-Za-z0-9_-]{8,128}$/
+const summaryKeys = new Set(['id', 'title', 'summary', 'revision', 'contentHash', 'visibility'])
+
+function invalid(): never { throw new Error(invalidMessage) }
+function object(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) invalid()
+  return value as Record<string, unknown>
+}
+function text(value: unknown, max = 20000): asserts value is string {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) invalid()
+}
+function hash(value: unknown): void {
+  if (typeof value !== 'string' || !hashPattern.test(value)) invalid()
+}
+function timestamp(value: unknown): void {
+  text(value, 64)
+  if (!Number.isFinite(Date.parse(value))) invalid()
+}
+function list(value: unknown): unknown[] {
+  if (!Array.isArray(value) || value.length > 500) invalid()
+  return value
+}
+function nullableText(value: unknown): void { if (value !== null) text(value) }
+
+export function isHandoffOperation(value: string | null): value is string {
+  return value !== null && operationPattern.test(value)
+}
+
+/** JSON-only, ASCII field names; matches the server's recursive key ordering. */
+export function canonicalJson(value: unknown): string {
+  function sorted(entry: unknown, depth: number): JsonValue {
+    if (depth > 40) invalid()
+    if (entry === null || typeof entry === 'string' || typeof entry === 'boolean') return entry
+    if (typeof entry === 'number' && Number.isFinite(entry)) return entry
+    if (Array.isArray(entry)) return entry.map((item) => sorted(item, depth + 1))
+    const record = object(entry)
+    const keys = Object.keys(record).sort()
+    if (keys.some((key) => !/^[\x20-\x7e]+$/.test(key))) invalid()
+    return Object.fromEntries(keys.map((key) => [key, sorted(record[key], depth + 1)]))
+  }
+  return JSON.stringify(sorted(value, 0))
+}
+
+export async function contentDigest(value: unknown): Promise<string> {
+  const bytes = new TextEncoder().encode(canonicalJson(value))
+  const digest = await crypto.subtle.digest('SHA-256', bytes)
+  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+async function verifyDigest(value: Record<string, unknown>): Promise<void> {
+  hash(value.digest)
+  const { digest, ...contents } = value
+  if (await contentDigest(contents) !== digest) invalid()
+}
+
+export function isSafeReturnUrl(value: unknown): value is string {
+  if (typeof value !== 'string' || value.length > 8000 || /[\s\\]/.test(value) || [...value].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127)) return false
+  if (!value.startsWith('/variantenraum/index.html#') || value.endsWith('#')) return false
+  const url = new URL(value, 'https://roundtrip.invalid')
+  return url.origin === 'https://roundtrip.invalid' && url.pathname === '/variantenraum/index.html' && !url.search && Boolean(url.hash)
+}
+
+function validatePacket(value: unknown, operationId: string): VariantHandoffPacket {
+  const packet = object(value)
+  if (packet.format !== 'kintegrity.roundtrip.v1' || packet.operationId !== operationId || !isHandoffOperation(operationId)) invalid()
+  timestamp(packet.createdAt)
+  hash(packet.digest)
+  if (!isSafeReturnUrl(packet.returnUrl)) invalid()
+  const navigation = object(packet.navigation)
+  text(navigation.hash, 8000)
+  if (!navigation.hash.startsWith('#') || packet.returnUrl !== `/variantenraum/index.html${navigation.hash}`) invalid()
+  const mandate = object(packet.mandate)
+  if (mandate.executor !== 'Codex' || mandate.role !== 'Technische Ausführung') invalid()
+  text(mandate.text)
+  text(mandate.scope)
+  const target = object(packet.target)
+  if (target.name !== 'DAS DAZWISCHEN') invalid()
+  text(target.revision, 256)
+  const source = object(packet.source)
+  for (const field of ['catalogRevision', 'variantId', 'roomId']) text(source[field], 500)
+  hash(source.variantDigest)
+  const snapshot = object(source.variantSnapshot)
+  text(snapshot.title, 1000)
+  if (snapshot.id !== source.variantId || source.roomId !== 'room-dazwischen') invalid()
+  const snapshotBindings = list(snapshot.componentBindings)
+  for (const entry of list(source.bindings)) {
+    const binding = object(entry)
+    for (const field of ['componentId', 'componentTitle', 'sourceId', 'roomId', 'role', 'bindingStatus']) text(binding[field], 2000)
+    nullableText(binding.revision)
+    nullableText(binding.contentHash)
+    if (binding.roomId !== source.roomId) invalid()
+    const originalBinding = Object.fromEntries(Object.entries(binding).filter(([key]) => key !== 'componentTitle'))
+    if (!snapshotBindings.some((item) => canonicalJson(item) === canonicalJson(originalBinding))) invalid()
+  }
+  const sourceIds = new Set<string>()
+  for (const entry of list(source.sourceSummaries)) {
+    const summary = object(entry)
+    if (Object.keys(summary).some((key) => !summaryKeys.has(key)) || summary.visibility !== 'public') invalid()
+    for (const field of ['id', 'title', 'summary']) text(summary[field])
+    nullableText(summary.revision)
+    nullableText(summary.contentHash)
+    const id = summary.id as string
+    if (sourceIds.has(id)) invalid()
+    sourceIds.add(id)
+  }
+  for (const entry of list(source.bindings)) if (!sourceIds.has(object(entry).sourceId as string)) invalid()
+  for (const entry of list(source.dissent)) {
+    const dissent = object(entry)
+    for (const field of ['id', 'title', 'summary']) text(dissent[field])
+  }
+  return packet as unknown as VariantHandoffPacket
+}
+
+function validateReceipt(value: unknown, packet: VariantHandoffPacket): VariantHandoffReceipt {
+  const receipt = object(value)
+  text(receipt.id, 500)
+  hash(receipt.digest)
+  timestamp(receipt.createdAt)
+  if (receipt.packetDigest !== packet.digest || receipt.targetRevision !== packet.target.revision || receipt.returnUrl !== packet.returnUrl) invalid()
+  if (receipt.transport !== 'received' || receipt.review !== 'not-reviewed' || receipt.humanAcceptance !== 'open') invalid()
+  text(receipt.finding, 2000)
+  const actor = object(receipt.actor)
+  if (actor.name !== 'Codex' || actor.role !== packet.mandate.role || actor.mandate !== packet.mandate.text || actor.scope !== packet.mandate.scope || actor.identityBasis !== 'configured-local-technical-executor') invalid()
+  return receipt as unknown as VariantHandoffReceipt
+}
+
+export async function verifyHandoffEnvelope(value: unknown, operationId: string): Promise<VariantHandoffEnvelope> {
+  const envelope = object(value)
+  if (typeof envelope.withdrawn !== 'boolean' || !Object.hasOwn(envelope, 'receipt') || !Object.hasOwn(envelope, 'adoption')) invalid()
+  const packet = validatePacket(envelope.packet, operationId)
+  await verifyDigest(packet as unknown as Record<string, unknown>)
+  if (await contentDigest(packet.source.variantSnapshot) !== packet.source.variantDigest) invalid()
+  const receipt = envelope.receipt === null ? null : validateReceipt(envelope.receipt, packet)
+  if (receipt) await verifyDigest(receipt as unknown as Record<string, unknown>)
+  canonicalJson(envelope.adoption)
+  return { packet, receipt, withdrawn: envelope.withdrawn, adoption: envelope.adoption as JsonValue }
+}
+
+export async function loadHandoff(operationId: string, signal?: AbortSignal): Promise<VariantHandoffEnvelope> {
+  if (!isHandoffOperation(operationId)) invalid()
+  const response = await fetch(`/api/rundweg/handoffs/${encodeURIComponent(operationId)}`, { credentials: 'same-origin', cache: 'no-store', signal })
+  if (!response.ok) throw new Error('Die Übergabe ist zurzeit nicht erreichbar. Bitte erneut laden.')
+  return verifyHandoffEnvelope(await response.json(), operationId)
+}
+
+export async function acknowledgeHandoff(packet: VariantHandoffPacket, finding: string): Promise<VariantHandoffEnvelope> {
+  const cleaned = finding.trim()
+  if (cleaned.length < 10 || cleaned.length > 2000) throw new Error('Bitte einen Befund mit mindestens zehn Zeichen zum technischen Empfang eintragen.')
+  const response = await fetch(`/api/rundweg/handoffs/${encodeURIComponent(packet.operationId)}/receipt`, {
+    method: 'POST', credentials: 'same-origin', cache: 'no-store',
+    headers: { 'Content-Type': 'application/json', 'X-Rundweg-Request': '1' },
+    body: JSON.stringify({ packetDigest: packet.digest, finding: cleaned, disposition: 'received' }),
+  })
+  if (!response.ok) throw new Error(response.status === 409 ? 'Die Übergabe wurde inzwischen verändert oder bereits anders quittiert. Bitte neu laden.' : 'Die Quittung konnte nicht bestätigt werden. Bitte die Übergabe neu laden, bevor Sie es erneut versuchen.')
+  const envelope = await verifyHandoffEnvelope(await response.json(), packet.operationId)
+  if (envelope.packet.digest !== packet.digest || !envelope.receipt || envelope.receipt.finding !== cleaned) invalid()
+  return envelope
+}
+
+/** Technical tokens remain available in the deliberately opened provenance view. */
+export function handoffDisplayText(value: string): string {
+  return value
+    .replace(/\b[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}\b/gi, 'technische Kennung')
+    .replace(/\b[\da-f]{7,64}\b/gi, 'technischer Quellenstand')
+    .replace(/\/(?:Volumes|Users|home)\/[^\s,;]+/g, 'technischer Quellenpfad')
+}
diff --git a/src/components/VariantHandoffPanel.tsx b/src/components/VariantHandoffPanel.tsx
new file mode 100644
