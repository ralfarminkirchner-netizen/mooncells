+++ b/src/components/VariantHandoffPanel.tsx
@@ -0,0 +1,139 @@
+import { useEffect, useRef, useState } from 'react'
+import { acknowledgeHandoff, handoffDisplayText, isHandoffOperation, loadHandoff } from '../lib/variantHandoff'
+import type { VariantHandoffEnvelope } from '../types/variantHandoff'
+import './VariantHandoffPanel.css'
+
+const human = handoffDisplayText
+const loadError = 'Die Übergabe konnte nicht sicher geladen werden. Eine Quittierung ist nicht möglich.'
+
+export default function VariantHandoffPanel() {
+  const [requested] = useState(() => new URLSearchParams(window.location.search).get('rundweg'))
+  const [envelope, setEnvelope] = useState<VariantHandoffEnvelope | null>(null)
+  const [finding, setFinding] = useState('')
+  const [error, setError] = useState(requested !== null && !isHandoffOperation(requested) ? loadError : '')
+  const [loading, setLoading] = useState(isHandoffOperation(requested))
+  const [sending, setSending] = useState(false)
+  const [reload, setReload] = useState(0)
+  const heading = useRef<HTMLHeadingElement>(null)
+  const dialog = useRef<HTMLDialogElement>(null)
+
+  useEffect(() => {
+    if (requested === null) return
+    if (dialog.current && !dialog.current.open) dialog.current.showModal()
+    heading.current?.focus()
+    if (!isHandoffOperation(requested)) return
+    const controller = new AbortController()
+    void loadHandoff(requested, controller.signal).then((loaded) => {
+      if (controller.signal.aborted) return
+      setEnvelope(loaded)
+      setFinding(loaded.receipt?.finding ?? '')
+    }).catch(() => {
+      if (!controller.signal.aborted) setError(loadError)
+    }).finally(() => {
+      if (!controller.signal.aborted) setLoading(false)
+    })
+    return () => controller.abort()
+  }, [requested, reload])
+
+  if (requested === null) return null
+
+  function reloadHandoff() {
+    if (!isHandoffOperation(requested)) return
+    setLoading(true)
+    setError('')
+    setEnvelope(null)
+    setReload((value) => value + 1)
+  }
+
+  async function acknowledge() {
+    if (!envelope || envelope.withdrawn || envelope.receipt || loading || sending) return
+    setSending(true)
+    setError('')
+    try {
+      const result = await acknowledgeHandoff(envelope.packet, finding)
+      setEnvelope(result)
+      setFinding(result.receipt?.finding ?? finding)
+    } catch {
+      // Do not disclose server payloads, identifiers or URLs through error text.
+      setError('Die Quittung konnte nicht sicher bestätigt werden. Bitte neu laden; ein bereits gespeicherter Empfang bleibt dabei erhalten.')
+      setEnvelope(null)
+    } finally {
+      setSending(false)
+    }
+  }
+
+  const packet = envelope?.packet
+  const receipt = envelope?.receipt
+  return <dialog ref={dialog} className="variant-handoff" aria-labelledby="variant-handoff-heading" onCancel={(event) => event.preventDefault()}>
+    <div className="variant-handoff__sheet">
+      <header>
+        <p className="variant-handoff__eyebrow">Variantenraum · DAS DAZWISCHEN</p>
+        <h1 id="variant-handoff-heading" ref={heading} tabIndex={-1}>Übergabe mit Rückweg</h1>
+        <p>Dieser Anschluss überträgt die ausgewählte öffentliche Gesamtfassung und ihren gebundenen Raumbeitrag als Zusammenfassungen. Er öffnet keine private Originalpassage und ersetzt keine fachliche oder menschliche Entscheidung.</p>
+      </header>
+      {loading && <p role="status">Die Übergabe wird geladen und geprüft.</p>}
+      {error && <p className="variant-handoff__notice is-error" role="alert">{error}</p>}
+      {!packet && <nav className="variant-handoff__return" aria-label="Sicherer Ausgang">
+        {!loading && isHandoffOperation(requested) && <button type="button" onClick={reloadHandoff}>Übergabe erneut laden</button>}
+        <a href="/variantenraum/index.html">Zur Übersicht im Variantenraum</a>
+      </nav>}
+      {packet && <>
+        <section aria-labelledby="variant-handoff-origin">
+          <h2 id="variant-handoff-origin">Aus dem Variantenraum</h2>
+          <h3>{human(packet.source.variantSnapshot.title)}</h3>
+          <p>Der Rückweg bewahrt die ausgewählte Fassung und den mitgegebenen Ansichtskontext. Die technischen Quellenstände sind in den geschlossenen Details erhalten.</p>
+          <h3>Gebundene Beiträge</h3>
+          {packet.source.bindings.length === 0 ? <p>Keine einzelnen Beiträge im Paket gebunden.</p> : <ul>{packet.source.bindings.map((binding, index) => <li key={index}>
+            <strong>{human(binding.componentTitle)}</strong>
+            <p>{human(binding.role)}</p>
+          </li>)}</ul>}
+          <h3>Öffentliche Quellenzusammenfassungen</h3>
+          <p>Zusammenfassungen sind keine Originalpassagen. Private Quellen, Lesewege und deren genaue Passage werden hier nicht übernommen.</p>
+          {packet.source.sourceSummaries.length === 0 ? <p>Keine Quellenzusammenfassung mitgegeben.</p> : <ul>{packet.source.sourceSummaries.map((source, index) => <li key={index}>
+            <strong>{human(source.title)}</strong>
+            <p>{human(source.summary)}</p>
+          </li>)}</ul>}
+          <h3>Erhaltene Einwände</h3>
+          {packet.source.dissent.length === 0 ? <p>Keine Einwände im Paket mitgegeben. Daraus folgt keine Zustimmung.</p> : <ul>{packet.source.dissent.map((dissent, index) => <li key={index}>
+            <strong>{human(dissent.title)}</strong>
+            <p>{human(dissent.summary)}</p>
+          </li>)}</ul>}
+        </section>
+        <section aria-labelledby="variant-handoff-mandate">
+          <h2 id="variant-handoff-mandate">Verantwortung und Geltung</h2>
+          <p><strong>Codex · Technische Ausführung</strong></p>
+          <p>{human(packet.mandate.text)}</p>
+          <p><strong>Umfang:</strong> {human(packet.mandate.scope)}</p>
+          <p>Die Quittung belegt Empfang und technischen Anschluss dieses Pakets in DAS DAZWISCHEN. Fachliche Prüfung: noch nicht erfolgt. Menschliche Annahme: offen. Eine spätere Ableitung braucht eine eigene, verantwortete Entscheidung.</p>
+        </section>
+        {envelope.withdrawn && <section className="variant-handoff__notice" aria-labelledby="variant-handoff-withdrawn">
+          <h2 id="variant-handoff-withdrawn">Übergabe zurückgezogen</h2>
+          <p>Dieser Stand ist nur noch ein historischer Beleg. Ein neuer Empfang kann hier nicht quittiert werden.</p>
+        </section>}
+        {receipt ? <section className="variant-handoff__notice" aria-labelledby="variant-handoff-receipt">
+          <h2 id="variant-handoff-receipt">Technischer Empfang quittiert</h2>
+          <p><strong>Verantwortlich:</strong> Codex · Technische Ausführung</p>
+          <p><strong>Befund:</strong> {human(receipt.finding)}</p>
+          <p><strong>Empfangen:</strong> {new Date(receipt.createdAt).toLocaleString('de-DE')}</p>
+          <p>Das Paket und dieser Empfangsbeleg wurden auf ihre Bindung geprüft. Fachliche Prüfung und menschliche Annahme bleiben offen.</p>
+        </section> : !envelope.withdrawn && <section aria-labelledby="variant-handoff-acknowledge">
+          <h2 id="variant-handoff-acknowledge">Empfang bewusst festhalten</h2>
+          <p>Beschreiben Sie, was am technischen Anschluss tatsächlich festgestellt wurde. Mit dem Klick wird die fest benannte technische Ausführung quittiert; Sie bestätigen damit keine menschliche Annahme.</p>
+          <label htmlFor="variant-handoff-finding">Befund zum technischen Empfang</label>
+          <textarea id="variant-handoff-finding" rows={4} minLength={10} maxLength={2000} aria-describedby="variant-handoff-finding-help" value={finding} disabled={sending} onChange={(event) => setFinding(event.target.value)} />
+          <p id="variant-handoff-finding-help">Mindestens zehn Zeichen. Beschreiben Sie einen beobachteten technischen Befund.</p>
+          <button type="button" disabled={finding.trim().length < 10 || sending} onClick={() => { void acknowledge() }}>{sending ? 'Quittung wird geprüft …' : 'Technischen Empfang quittieren'}</button>
+        </section>}
+        <nav className="variant-handoff__return" aria-label="Rückweg zum Variantenraum">
+          <a href={receipt?.returnUrl ?? packet.returnUrl}>{receipt ? 'Mit Quittung zum Variantenraum zurück' : 'Ohne Quittung zurück'}</a>
+          <button type="button" disabled={sending} onClick={reloadHandoff}>Gespeicherten Stand neu laden</button>
+        </nav>
+        <details className="variant-handoff__technical">
+          <summary>Technische Bindung und Empfangsbeleg</summary>
+          <p>Das Paket und gegebenenfalls die Quittung sind im Browser kanonisch auf ihre Prüfsumme und gegenseitige Bindung geprüft. Dies ist ein technischer Integritätsnachweis, keine fachliche oder menschliche Zustimmung.</p>
+          <pre>{JSON.stringify(envelope, null, 2)}</pre>
+        </details>
+      </>}
+    </div>
+  </dialog>
+}
