@@ -0,0 +1,39 @@
+.variant-handoff {
+  position: fixed;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  max-width: none;
+  max-height: none;
+  margin: 0;
+  border: 0;
+  box-sizing: border-box;
+  z-index: 100;
+  overflow: auto;
+  padding: clamp(12px, 3vw, 40px);
+  color: #eae9e4;
+  background: #111a1e;
+  text-align: left;
+}
+.variant-handoff__sheet { max-width: 860px; margin: 0 auto; overflow-wrap: anywhere; }
+.variant-handoff header { margin-bottom: 28px; }
+.variant-handoff h1 { font-size: clamp(1.8rem, 6vw, 3rem); line-height: 1.12; margin: 10px 0 20px; }
+.variant-handoff h2 { font-size: 1.3rem; line-height: 1.3; margin: 0 0 16px; }
+.variant-handoff h3 { font-size: 1.05rem; line-height: 1.4; margin: 24px 0 8px; }
+.variant-handoff p { max-width: 72ch; line-height: 1.65; margin: 8px 0 14px; }
+.variant-handoff__eyebrow { color: #91d5cb; font-size: .85rem; }
+.variant-handoff section { border-top: 1px solid #405256; padding: 24px 0; }
+.variant-handoff ul { margin: 12px 0; padding-left: 24px; }
+.variant-handoff li { margin: 0 0 20px; }
+.variant-handoff label { display: block; font-weight: 600; margin: 18px 0 8px; }
+.variant-handoff textarea { display: block; box-sizing: border-box; width: 100%; max-width: 100%; min-height: 110px; padding: 12px; margin-bottom: 14px; resize: vertical; color: #f2f2eb; background: #19272b; border: 1px solid #74958f; border-radius: 8px; font: inherit; }
+.variant-handoff button, .variant-handoff__return a { display: inline-block; max-width: 100%; box-sizing: border-box; padding: 12px 16px; min-height: 44px; margin: 4px 8px 4px 0; border: 1px solid #83b6ac; border-radius: 8px; background: #213b3c; color: #f0f5ed; font: inherit; white-space: normal; line-height: 1.45; text-decoration: none; cursor: pointer; }
+.variant-handoff button:disabled { opacity: .55; cursor: default; }
+.variant-handoff :is(button, a, textarea, summary):focus-visible { outline: 3px solid #ead69c; outline-offset: 4px; }
+.variant-handoff__notice { padding: 20px !important; margin: 18px 0; border: 1px solid #81afa4 !important; border-radius: 10px; background: #19312f; }
+.variant-handoff__notice.is-error { border-color: #dc9b88 !important; background: #3e2824; }
+.variant-handoff__return { padding: 20px 0; border-top: 1px solid #405256; }
+.variant-handoff__technical { margin: 12px 0 32px; padding: 16px; border: 1px solid #405256; border-radius: 8px; }
+.variant-handoff__technical summary { cursor: pointer; padding: 6px 0; }
+.variant-handoff__technical pre { max-width: 100%; overflow: auto; padding: 14px; font-size: .78rem; line-height: 1.5; background: #0b1215; }
